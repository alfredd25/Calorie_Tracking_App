
# ──────────────────────────────────────────────────────────────────────────────
# Security
# ──────────────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ⚠  APPLICATION WILL REFUSE TO START if SECRET_KEY is not set.
SECRET_KEY=replace_with_a_strong_random_secret

# JWT token lifetimes (minutes). Defaults: access=60, refresh=10080 (7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ──────────────────────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=calorie_user
POSTGRES_PASSWORD=replace_with_strong_db_password
POSTGRES_DB=calorie_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ──────────────────────────────────────────────────────────────────────────────
# Redis / Celery
# ──────────────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────────────────────
# Email  (required for the forgot-password flow)
# ──────────────────────────────────────────────────────────────────────────────
# RESEND_API_KEY  — your Resend API key.
#   Create one at: https://resend.com/api-keys
#
# RESEND_FROM_EMAIL — sender address on your verified Resend domain.
#   Must match a domain you have verified in the Resend dashboard.
#
# ⚠  The forgot-password endpoint returns HTTP 500 until RESEND_API_KEY is set.
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=noreply@nutritracks.tech

# ──────────────────────────────────────────────────────────────────────────────
# Frontend URL  (used to build the password-reset link in emails)
# ──────────────────────────────────────────────────────────────────────────────
# Override this in production with your real domain, e.g. https://app.example.com
CLIENT_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────────
# Monitoring  (Grafana + /metrics endpoint access control)
# ──────────────────────────────────────────────────────────────────────────────
# Comma-separated IPs allowed to scrape /metrics. Defaults to localhost only.
METRICS_ALLOWED_IPS=127.0.0.1,::1

# ⚠  Never use the default "admin" password in production.
GRAFANA_ADMIN_PASSWORD=replace_with_strong_grafana_password
